---
import type { Project } from '../types/project';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---
<article class="p-6 border border-stone-200/80 bg-white/60 rounded-xl hover:border-stone-400 transition-all shadow-sm">
  <div class="flex items-center justify-between text-xs text-stone-500 mb-3">
    <span>{project.yearRange}</span>
    <span class="font-medium text-stone-700">{project.role}</span>
  </div>
  
  <h3 class="text-xl font-serif font-bold text-ink-900">{project.title}</h3>
  <p class="text-sm font-medium text-stone-600 mt-1">{project.subtitle}</p>
  <p class="mt-3 text-sm text-stone-600 leading-relaxed">{project.description}</p>
  
  <div class="mt-6 flex flex-wrap gap-2">
    {project.techStack.map((tech) => (
      <span class="px-2.5 py-1 text-xs bg-cream-200/70 text-ink-800 rounded font-mono">
        {tech}
      </span>
    ))}
  </div>

  <div class="mt-6 pt-4 border-t border-stone-100 flex gap-4 text-xs font-semibold text-ink-900">
    {project.links.live && (
      <a href={project.links.live} target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-1">
        Live Project &rarr;
      </a>
    )}
    {project.links.caseStudy && (
      <a href={project.links.caseStudy} class="hover:underline">
        View Details &rarr;
      </a>
    )}
  </div>
</article>