---
export interface Props {
  calLink: string;
}

const { calLink } = Astro.props;
---
<div class="w-full my-6">
  <iframe
    src={`https://cal.com/${calLink}`}
    width="100%"
    height="650px"
    class="rounded-xl border border-stone-200 shadow-sm bg-white"
    allow="camera; microphone; payment">
  </iframe>
</div>