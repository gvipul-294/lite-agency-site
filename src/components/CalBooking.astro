---
export interface Props {
  calLink?: string;
}

const { calLink } = Astro.props;
const bookingUrl = calLink
  ? calLink.startsWith('http')
    ? calLink
    : `https://cal.com/${calLink.replace(/^\/+/, '')}`
  : undefined;
---
<div class="w-full my-6">
  {bookingUrl ? (
    <iframe
      src={bookingUrl}
      title="Book a consultation"
      width="100%"
      height="650px"
      class="rounded-xl border border-stone-200 shadow-sm bg-white"
      allow="camera; microphone; payment">
    </iframe>
  ) : (
    <div class="rounded-xl border border-dashed border-stone-300 bg-cream-200/50 p-6 text-sm text-stone-600">
      Booking will be available here shortly. In the meantime, send a message below and we will arrange a time that works for you.
    </div>
  )}
</div>
