---
import { getCollection, type CollectionEntry } from 'astro:content';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC'
});

// Only top-level sections make a useful sidebar; deeper nesting gets noisy.
const tableOfContents = headings.filter((heading) => heading.depth === 2);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} | Studio</title>
    <meta name="description" content={post.data.description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.description} />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
  </head>
  <body class="bg-cream-100 min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-grow max-w-5xl mx-auto px-6 py-16 w-full">
      <a href="/blog" class="text-xs font-semibold text-stone-500 hover:text-ink-900 transition-colors">
        &larr; All notes
      </a>

      <header class="mt-6 pb-10 border-b border-stone-200">
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-ink-900 leading-tight max-w-3xl">
          {post.data.title}
        </h1>
        <p class="mt-4 text-lg text-stone-600 max-w-2xl leading-relaxed">
          {post.data.description}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-stone-500">
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          {post.data.readingTime && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{post.data.readingTime}</span>
            </>
          )}
        </div>
        {post.data.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="px-2.5 py-1 text-xs bg-cream-200/70 text-ink-800 rounded font-mono">
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      <div class="mt-10 lg:flex lg:gap-12">
        {tableOfContents.length > 0 && (
          <aside class="lg:w-56 lg:flex-none lg:order-2">
            <div class="lg:sticky lg:top-24 pb-8 lg:pb-0 mb-8 lg:mb-0 border-b lg:border-b-0 border-stone-200">
              <h2 class="text-xs uppercase tracking-widest font-semibold text-stone-500">
                On this page
              </h2>
              <ul class="mt-4 space-y-2 text-sm">
                {tableOfContents.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="text-stone-600 hover:text-ink-900 transition-colors"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )}

        <article class="article min-w-0 lg:flex-1 lg:order-1 max-w-2xl">
          <Content />
        </article>
      </div>

      <div class="mt-16 pt-10 border-t border-stone-200 flex flex-wrap items-center justify-between gap-4">
        <p class="text-sm text-stone-600">Working on something similar? We would like to hear about it.</p>
        <a
          href="/contact"
          class="px-6 py-3 bg-ink-900 text-cream-100 font-medium text-sm rounded-md hover:bg-stone-800 transition-colors"
        >
          Book a call
        </a>
      </div>
    </main>
    <Footer />
  </body>
</html>
