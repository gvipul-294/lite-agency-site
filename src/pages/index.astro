---
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { PROJECTS } from '../data/projects';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const featuredProjects = PROJECTS.filter((p) => p.featured);

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Software Engineering Studio</title>
  </head>
  <body class="bg-cream-100 min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-grow">
      <Hero />
      
      <section class="max-w-5xl mx-auto px-6 py-12">
        <div class="flex justify-between items-end mb-8">
          <div>
            <h2 class="text-2xl font-serif font-bold text-ink-900">Featured Showcase</h2>
            <p class="text-sm text-stone-600 mt-1">A selection of systems we have designed, built, and shipped.</p>
          </div>
          <a href="/work" class="text-sm font-semibold text-ink-900 hover:underline">View all &rarr;</a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>

      {latestPosts.length > 0 && (
        <section class="max-w-5xl mx-auto px-6 py-12 border-t border-cream-300/60">
          <div class="flex justify-between items-end mb-8">
            <div>
              <h2 class="text-2xl font-serif font-bold text-ink-900">Notes &amp; Writing</h2>
              <p class="text-sm text-stone-600 mt-1">How we scope, architect, and ship client work.</p>
            </div>
            <a href="/blog" class="text-sm font-semibold text-ink-900 hover:underline">Read all &rarr;</a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {latestPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )}
    </main>
    <Footer />
  </body>
</html>