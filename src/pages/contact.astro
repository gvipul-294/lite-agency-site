---
import Navbar from '../components/Navbar.astro';
import CalBooking from '../components/CalBooking.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const calLink = import.meta.env.PUBLIC_CAL_LINK;
const formspreeFormId = import.meta.env.PUBLIC_FORMSPREE_FORM_ID;
const formAction = formspreeFormId ? `https://formspree.io/f/${formspreeFormId}` : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact & Booking | Studio</title>
  </head>
  <body class="bg-cream-100 min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-grow max-w-4xl mx-auto px-6 py-16 w-full">
      <h1 class="text-4xl font-serif font-bold text-ink-900">Get in Touch</h1>
      <p class="text-stone-600 mt-2">
        Book a consultation with our team, or send us a message and we will get back to you.
      </p>
      <p class="mt-3 text-sm text-stone-600">
        You can also connect with us on <a href="https://www.linkedin.com/in/vipul294/" target="_blank" rel="noreferrer" class="font-semibold text-ink-900 hover:underline">LinkedIn</a>.
      </p>

      <section class="mt-10">
        <h2 class="text-xl font-serif font-semibold text-ink-900 mb-4">Direct Schedule</h2>
        <CalBooking calLink={calLink} />
      </section>

      <section class="mt-16 pt-12 border-t border-stone-300">
        <h2 class="text-xl font-serif font-semibold text-ink-900 mb-2">Send a Message</h2>
        <p class="text-sm text-stone-600 mb-6">Prefer email? Tell us about your project and we will reply within one business day.</p>

        {formAction ? (
          <form action={formAction} method="POST" class="space-y-4 max-w-xl" data-contact-form>
            <input type="hidden" name="_subject" value="New project enquiry" />
            <input type="hidden" data-formspree-next />
            <div>
              <label for="name" class="block text-xs font-semibold text-stone-700 uppercase">Name</label>
              <input type="text" id="name" name="name" autocomplete="name" required class="mt-1 w-full p-3 rounded border border-stone-300 bg-white focus:outline-none focus:border-ink-900 text-sm" />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-stone-700 uppercase">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" required class="mt-1 w-full p-3 rounded border border-stone-300 bg-white focus:outline-none focus:border-ink-900 text-sm" />
            </div>
            <div>
              <label for="message" class="block text-xs font-semibold text-stone-700 uppercase">Project Overview</label>
              <textarea id="message" name="message" rows="4" required class="mt-1 w-full p-3 rounded border border-stone-300 bg-white focus:outline-none focus:border-ink-900 text-sm"></textarea>
            </div>
            <button type="submit" class="px-6 py-3 bg-ink-900 text-cream-100 font-medium text-sm rounded hover:bg-stone-800 transition-colors">
              Send Message
            </button>
          </form>
          <div class="max-w-xl rounded-xl border border-stone-300 bg-white p-6 text-sm leading-relaxed text-stone-700" role="status" hidden data-sent-message>
            <p class="font-semibold text-ink-900">Thanks — your message is on its way.</p>
            <p class="mt-1">We will be in touch within one business day.</p>
          </div>
          <script>
            const nextField = /** @type {HTMLInputElement | null} */ (document.querySelector('[data-formspree-next]'));
            const contactForm = document.querySelector('[data-contact-form]');
            const sentMessage = document.querySelector('[data-sent-message]');

            if (nextField) {
              nextField.name = '_next';
              nextField.value = `${window.location.origin}/contact?sent=true`;
            }

            if (window.location.search.includes('sent=true') && contactForm && sentMessage) {
              contactForm.setAttribute('hidden', '');
              sentMessage.removeAttribute('hidden');
            }
          </script>
        ) : (
          <div class="max-w-xl rounded-xl border border-dashed border-stone-300 bg-cream-200/50 p-6 text-sm leading-relaxed text-stone-600">
            We are preparing our secure contact form. Please check back shortly to tell us about your project.
          </div>
        )}
      </section>
    </main>
    <Footer />
  </body>
</html>
